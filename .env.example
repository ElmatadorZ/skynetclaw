# SkynetClaw / THE HOUSE — environment template.
# Copy to .env and fill in. Local Ollama is the default; no keys needed for local use.

# ── Where the local model runtime lives ──
# Default http://localhost:11434. Set this when Ollama is not on this machine —
# docker compose sets it to http://ollama:11434, since inside a container
# "localhost" is the container itself, not the host.
OLLAMA_BASE_URL=

# ── Optional cloud LLM providers (only if you add a cloud connection) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Optional integrations ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional web_search provider keys (search_providers.py) ──
# With none set, web_search falls back to free scrapers (unreliable — Brave 429,
# public SearXNG down). Set ANY ONE to get a reliable, deterministic primary source;
# a keyed provider is tried first, free providers remain the fallback. Interface and
# output are unchanged either way. Pick one you have an account for:
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Optional: override the institutional-memory DB path (default: backend/skynerclaw.db) ──
INSTITUTIONAL_DB=
